{
  "name": "agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first persistent project execution workspace for AI agents",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm --filter @agent-workspace/web build",
    "build:ts": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean && rimraf apps/web/dist",
    "typecheck": "tsc -b tsconfig.build.json && pnpm --filter @agent-workspace/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @agent-workspace/server dev",
    "dev:web": "pnpm --filter @agent-workspace/web dev",
    "server": "node apps/server/dist/bin.js",
    "mcp": "node apps/mcp/dist/bin.js",
    "aw": "node apps/cli/dist/bin.js",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@agent-workspace/config": "workspace:*",
    "@agent-workspace/core": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
